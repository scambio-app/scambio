[Desktop Entry]
Type=Application
Name=Scambio
Comment=Hands your Bluetooth audio between computer and phone
Comment[it]=Passa l’audio Bluetooth fra computer e telefono
Comment[de]=Gibt dein Bluetooth-Audio zwischen Computer und Handy weiter
Icon=@ICON@
Exec=@EXEC@ settings
TryExec=@EXEC@
Terminal=false
Categories=Settings;HardwareSettings;
Keywords=Bluetooth;audio;headphones;headset;glasses;multipoint;
Keywords[it]=Bluetooth;audio;cuffie;auricolari;occhiali;multipoint;
Keywords[de]=Bluetooth;Audio;Kopfhörer;Headset;Brille;Multipoint;
StartupNotify=true
StartupWMClass=app.scambio.Scambio.Settings
