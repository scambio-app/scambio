  "vectors": [
    {
      "id": "flow.double-switch-waits-for-disconnect",
      "rules": ["O6", "L3", "L0", "L1", "C1", "C3", "O12", "dec.68"],
      "origin": "tests/test_policy_players.py::test_double_switch_waits_for_disconnect_signal",
      "clock": "virtual",
      "note": "t_ms illustrativi, ispirati a M22(b); non sono misure",
      "config": {"resume_delay_ms": 2000},
      "initial": {
        "context": {"state": "on_pc", "device_connected": true, "sink_ready": true, "routed": true, "audio_active": true, "origin": "self"}
      },
      "steps": [
        {
          "t_ms": 0,
          "event": {"type": "Switch"},
          "expect": {
            "actions": [
              {"type": "SavePriority", "value": true},
              {"type": "CancelTimer", "timer": "IDLE"},
              {"type": "CancelTimer", "timer": "GRAB_DELAY"},
              {"type": "CancelTimer", "timer": "CONNECT"},
              {"type": "CancelTimer", "timer": "SINK"},
              {"type": "CancelTimer", "timer": "RESUME"},
              {"type": "PausePlayers", "kind": "release"},
              {"type": "RestoreRouting"},
              {"type": "Disconnect"},
              {"type": "StartTimer", "timer": "RELEASE", "ms": 10000},
              {"type": "EmitTransition", "from": "on_pc", "to": "releasing", "reason": "switch"}
            ],
            "changes": {"state": "releasing", "priority": true, "routed": false, "reason": "switch", "held": true}
          }
        },
        {
          "t_ms": 120,
          "event": {"type": "AudioActive", "value": false},
          "expect": {"actions": [], "changes": {"audio_active": false}}
        },
        {
          "t_ms": 167,
          "event": {"type": "Switch"},
          "expect": {
            "actions": [{"type": "SavePriority", "value": false}],
            "changes": {"priority": false, "pending": "grab"}
          }
        },
        {
          "t_ms": 2390,
          "event": {"type": "DisconnectResult", "result": "ok"},
          "expect": {"actions": [], "changes": {}}
        },
        {
          "t_ms": 2396,
          "event": {"type": "DeviceSinkGone"},
          "expect": {"actions": [], "changes": {"sink_ready": false}}
        },
        {
          "t_ms": 2405,
          "event": {"type": "DeviceConnected", "value": false},
          "expect": {
            "actions": [
              {"type": "CancelTimer", "timer": "RELEASE"},
              {"type": "PausePlayers", "kind": "grab"},
              {"type": "Connect"},
              {"type": "StartTimer", "timer": "CONNECT", "ms": 10000},
              {"type": "EmitTransition", "from": "releasing", "to": "connecting", "reason": "switch"}
            ],
            "changes": {"state": "connecting", "device_connected": false, "pending": "none"}
          }
        },
        {
          "t_ms": 3090,
          "event": {"type": "ConnectResult", "result": "ok"},
          "expect": {
            "actions": [
              {"type": "CancelTimer", "timer": "CONNECT"},
              {"type": "StartTimer", "timer": "SINK", "ms": 5000}
            ],
            "changes": {}
          }
        },
        {
          "t_ms": 3101,
          "event": {"type": "DeviceConnected", "value": true},
          "expect": {"actions": [], "changes": {"device_connected": true}}
        },
        {
          "t_ms": 3720,
          "event": {"type": "DeviceSinkAppeared"},
          "expect": {
            "actions": [
              {"type": "CancelTimer", "timer": "CONNECT"},
              {"type": "CancelTimer", "timer": "SINK"},
              {"type": "RouteToDevice"},
              {"type": "StartTimer", "timer": "RESUME", "ms": 2000},
              {"type": "EmitTransition", "from": "connecting", "to": "on_pc", "reason": "switch"}
            ],
            "changes": {"state": "on_pc", "sink_ready": true, "routed": true}
