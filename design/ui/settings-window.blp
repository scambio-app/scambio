// Finestra impostazioni di Scambio (spec 04). Contratto: docs/context/05-ui-context.md §5.10.
// Testi: chiavi gettext del dominio "scambio" (design/i18n/*.po); quelli che dipendono dallo
// stato (riga di stato, pulsante, sottotitoli variabili, elenchi) li imposta il codice con le
// chiavi elencate nel contratto. Compila con blueprint-compiler 0.12 (libadwaita ≥ 1.4).
using Gtk 4.0;
using Adw 1;

translation-domain "scambio";

template $ScambioSettingsWindow : Adw.ApplicationWindow {
  title: _("settings-window-title");
  default-width: 560;
  default-height: 820;
  width-request: 360;
  height-request: 400;

  content: Adw.ToastOverlay toast_overlay {
    child: Adw.ToolbarView {
      [top]
      Adw.HeaderBar {}

      [top]
      Adw.Banner daemon_banner {
        title: _("settings-daemon-down");
        button-label: _("settings-daemon-start");
        action-name: "app.start-daemon";
        revealed: false;
      }

      content: Adw.PreferencesPage settings_page {
        Adw.PreferencesGroup status_group {
          Adw.ActionRow status_row {
            styles ["scambio-hero"]
            // titolo = header, sottotitolo = detail della regola di tray.json (senza errore)

            [prefix]
            Image status_icon {
              icon-name: "app.scambio.Scambio-released-symbolic";
              pixel-size: 32;
              valign: center;
              styles ["scambio-hero-icon"]
            }

            [suffix]
            Button switch_button {
              label: _("tray-action-to-pc");
              action-name: "app.switch";
              valign: center;
              styles ["suggested-action", "pill"]
            }
          }

          Adw.SwitchRow priority_row {
            title: _("tray-action-priority");
            subtitle: _("settings-priority-subtitle");
          }
        }

        Adw.PreferencesGroup device_group {
          title: _("settings-group-device");

          Adw.ComboRow device_row {
            title: _("settings-device-title");
            // modello e sottotitolo dal codice (05 §5.10)
          }

          Adw.SpinRow release_idle_row {
            title: _("settings-release-title");
            subtitle: _("settings-release-subtitle");
            numeric: true;
            adjustment: Adjustment release_idle_adjustment {
              lower: 1;
              upper: 60;
              step-increment: 1;
              page-increment: 5;
              value: 2;
            };
          }
        }

        Adw.PreferencesGroup shortcut_group {
          title: _("settings-group-shortcut");

          Adw.ActionRow shortcut_row {
            title: _("settings-shortcut-title");
            subtitle: _("settings-shortcut-subtitle");
            subtitle-lines: 3;

            [suffix]
            ShortcutLabel shortcut_label {
              accelerator: "<Super>g";
              disabled-text: _("settings-shortcut-unbound");
              valign: center;
            }

            [suffix]
            Button shortcut_change_button {
              label: _("settings-shortcut-change");
              action-name: "app.change-shortcut";
              valign: center;
            }
          }
        }

        Adw.PreferencesGroup general_group {
          title: _("settings-group-general");

          Adw.SwitchRow tray_row {
            title: _("settings-tray");
            subtitle: _("settings-tray-subtitle");
          }

          Adw.SwitchRow notifications_row {
            title: _("settings-notifications");
            subtitle: _("settings-notifications-subtitle");
          }

          Adw.ComboRow language_row {
            title: _("settings-language");
            model: StringList {
              strings [_("settings-language-auto"), "Italiano", "English", "Deutsch"]
            };
          }

          Adw.ActionRow config_row {
            title: _("settings-config-title");
            subtitle: _("settings-config-subtitle");

            [suffix]
            Button config_open_button {
              label: _("settings-config-open");
              action-name: "app.open-config";
              valign: center;
            }
          }
        }

        Adw.PreferencesGroup footer_group {
          Label version_label {
            label: "Scambio";
            styles ["dim-label", "caption"]
          }
        }
      };
    };
  };
}
