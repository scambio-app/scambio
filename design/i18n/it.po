# Scambio — testi dell'interfaccia (italiano).
# Proprietà di Claude (design/). Chiavi simboliche: msgid = chiave del contratto
# in docs/context/05-ui-context.md; en.po è obbligatorio come gli altri.
# Segnaposto: {device}, {minutes}, {time}, {error}, {shortcut}, {owner}, {version} (str.format).
msgid ""
msgstr ""
"Project-Id-Version: scambio 0.1\n"
"PO-Revision-Date: 2026-10-07 01:00+0200\n"
"Last-Translator: Claude (design di Scambio)\n"
"Language-Team: Scambio\n"
"Language: it\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#. Al posto di {device} quando BlueZ non dà un nome. Minuscolo: il codice rende maiuscola la prima lettera della frase.
msgid "tray-device-fallback"
msgstr "il dispositivo"

#. Prima riga del menu e del tooltip.
#. segnaposto: {device}
msgid "tray-header-released"
msgstr "{device} — libero per il telefono"

#. segnaposto: {device}
msgid "tray-header-priority"
msgstr "{device} — riservato al telefono"

#. segnaposto: {device}
msgid "tray-header-connecting"
msgstr "{device} — passaggio al PC…"

#. segnaposto: {device}
msgid "tray-header-on-pc"
msgstr "{device} — sul PC"

#. segnaposto: {device}
msgid "tray-header-releasing"
msgstr "{device} — ritorno al telefono…"

#. segnaposto: {device}
msgid "tray-header-unavailable"
msgstr "{device} — non disponibile"

msgid "tray-header-not-configured"
msgstr "Nessun dispositivo configurato"

#. Seconda riga del menu e del tooltip.
msgid "tray-detail-released"
msgstr "Passa al PC quando parte un audio"

msgid "tray-detail-priority"
msgstr "Il PC non lo prende in automatico"

msgid "tray-detail-busy"
msgstr "Qualche secondo…"

msgid "tray-detail-playing"
msgstr "Audio del PC in riproduzione"

#. Menu: minuti arrotondati per eccesso, calcolati all’apertura.
#. segnaposto: {minutes}
msgid "tray-detail-idle"
msgstr "Torna al telefono tra {minutes} min"

msgid "tray-detail-idle-soon"
msgstr "Torna al telefono tra meno di un minuto"

#. Tooltip: ora assoluta HH:MM, così non invecchia.
#. segnaposto: {time}
msgid "tray-detail-idle-at"
msgstr "Torna al telefono alle {time}"

msgid "tray-detail-on-pc"
msgstr "Audio del PC sul dispositivo"

msgid "tray-detail-unavailable"
msgstr "Bluetooth spento o dispositivo fuori portata"

#. Spec 05: la finestra sceglie il dispositivo; il percorso del file cambia nel Flatpak.
msgid "tray-detail-not-configured"
msgstr "Sceglilo nelle Impostazioni"

#. Mostrato finché l’errore non è visto (05 §5.4).
msgid "tray-detail-error-connect"
msgstr "Ultimo passaggio non riuscito: è acceso e vicino?"

msgid "tray-detail-error-sink"
msgstr "Audio perso: è tornato sugli altoparlanti del PC"

msgid "tray-detail-error-release"
msgstr "Rilascio non riuscito: resta sul PC"

msgid "tray-detail-error-config"
msgstr "Configurazione non valida: in uso la precedente"

msgid "tray-action-to-pc"
msgstr "Passa al PC"

msgid "tray-action-to-phone"
msgstr "Lascia al telefono"

msgid "tray-action-priority"
msgstr "Priorità telefono"

msgid "tray-action-settings"
msgstr "Impostazioni…"

msgid "tray-action-quit"
msgstr "Esci da Scambio"

#. segnaposto: {device}
msgid "notify-grab-failed-title"
msgstr "{device} non raggiungibile"

msgid "notify-grab-failed-body"
msgstr "Non sono riuscito a portarlo sul PC. È acceso e vicino?"

#. segnaposto: {device}
msgid "notify-sink-lost-title"
msgstr "{device}: audio non disponibile"

msgid "notify-sink-lost-body"
msgstr "L’audio è tornato sugli altoparlanti del PC."

#. segnaposto: {device}
msgid "notify-release-failed-title"
msgstr "{device} resta sul PC"

msgid "notify-release-failed-body"
msgstr "Non sono riuscito a lasciarlo al telefono."

#. segnaposto: {device}
msgid "notify-unavailable-title"
msgstr "{device} non disponibile"

msgid "notify-unavailable-body"
msgstr "Bluetooth spento o dispositivo fuori portata."

msgid "notify-not-configured-title"
msgstr "Scambio non ha un dispositivo"

msgid "notify-not-configured-body"
msgstr "Indica l’indirizzo Bluetooth nel file di configurazione."

msgid "notify-config-invalid-title"
msgstr "Configurazione non valida"

msgid "notify-config-invalid-body"
msgstr "Scambio continua con quella precedente. Dettagli nel registro di sistema."

msgid "notify-audio-down-title"
msgstr "Scambio non sente l’audio del PC"

msgid "notify-audio-down-body"
msgstr "Senza, niente passaggio automatico; lo switch funziona. Controlla pactl (pacchetto pulseaudio-utils)."

#. Switch partito fuori dal tray (scorciatoia, CLI).
#. segnaposto: {device}
msgid "notify-switch-to-phone-title"
msgstr "{device} lasciato al telefono"

msgid "notify-switch-to-phone-body"
msgstr "Priorità telefono attiva: il PC non lo riprenderà da solo."

#. segnaposto: {device}
msgid "notify-switch-to-pc-title"
msgstr "{device} sul PC"

msgid "notify-switch-to-pc-body"
msgstr "Priorità telefono disattivata."

#. Priorità cambiata fuori dal tray senza switch (es. scambio priority on).
msgid "notify-priority-on-title"
msgstr "Priorità telefono attiva"

#. segnaposto: {device}
msgid "notify-priority-on-body"
msgstr "Il PC non prenderà {device} in automatico."

msgid "notify-priority-off-title"
msgstr "Priorità telefono disattivata"

#. segnaposto: {device}
msgid "notify-priority-off-body"
msgstr "Il PC prende {device} quando parte un audio."

msgid "notify-action-retry"
msgstr "Riprova"

msgid "notify-action-undo"
msgstr "Annulla"

msgid "notify-action-open-config"
msgstr "Apri il file"

#. Finestra impostazioni (spec 04). Titolo della finestra.
msgid "settings-window-title"
msgstr "Scambio"

#. Banner in cima quando il demone non è sul bus.
msgid "settings-daemon-down"
msgstr "Scambio non è in esecuzione"

msgid "settings-daemon-start"
msgstr "Avvia"

#. Riga di stato quando il demone non è in esecuzione.
msgid "settings-status-unknown"
msgstr "Stato non disponibile"

msgid "settings-priority-subtitle"
msgstr "Il PC non prende il dispositivo in automatico"

msgid "settings-group-device"
msgstr "Dispositivo"

msgid "settings-device-title"
msgstr "Occhiali o cuffie Bluetooth"

#. Voce dell’elenco quando non è configurato alcun dispositivo.
msgid "settings-device-none"
msgstr "Nessuno"

#. Sottotitolo: elenco bloccato mentre il dispositivo è sul PC o in passaggio.
msgid "settings-device-busy"
msgstr "Per cambiarlo, prima lascialo al telefono"

msgid "settings-device-empty"
msgstr "Nessun dispositivo audio accoppiato: accoppialo nelle impostazioni Bluetooth"

#. Avviso breve (toast).
msgid "settings-device-restarting"
msgstr "Scambio si riavvia con il nuovo dispositivo"

msgid "settings-release-title"
msgstr "Torna al telefono dopo (minuti)"

msgid "settings-release-subtitle"
msgstr "Di silenzio sul PC. Subito al blocco dello schermo e in sospensione"

msgid "settings-group-shortcut"
msgstr "Scorciatoia"

msgid "settings-shortcut-title"
msgstr "Switch intelligente"

msgid "settings-shortcut-subtitle"
msgstr "Sposta il dispositivo e attiva o toglie la Priorità telefono"

#. Al posto del tasto quando la scorciatoia non ha un tasto.
msgid "settings-shortcut-unbound"
msgstr "Nessun tasto"

#. Sottotitolo in caso di conflitto. {shortcut} = tasto leggibile (es. Meta+G), {owner} = nome dell’azione che lo usa.
#. segnaposto: {owner}, {shortcut}
msgid "settings-shortcut-conflict"
msgstr "{shortcut} è già usata da «{owner}»"

msgid "settings-shortcut-unsupported"
msgstr "Questo desktop non offre scorciatoie globali: assegna un tasto al comando «scambio switch»"

#. Apre Impostazioni di sistema → Scorciatoie (KDE).
msgid "settings-shortcut-change"
msgstr "Cambia…"

msgid "settings-group-general"
msgstr "Generale"

msgid "settings-tray"
msgstr "Icona nella barra di sistema"

msgid "settings-tray-subtitle"
msgstr "Su GNOME serve l’estensione AppIndicator"

msgid "settings-notifications"
msgstr "Notifiche"

msgid "settings-notifications-subtitle"
msgstr "Solo errori e cambi della Priorità telefono fatti da fuori"

msgid "settings-language"
msgstr "Lingua"

#. Le altre voci restano nella propria lingua: Italiano, English, Deutsch.
msgid "settings-language-auto"
msgstr "Automatica"

#. Avviso breve (toast).
msgid "settings-language-next-open"
msgstr "La finestra cambierà lingua alla prossima apertura"

msgid "settings-config-title"
msgstr "File di configurazione"

msgid "settings-config-subtitle"
msgstr "Ritardo di presa, app ignorate e altri dettagli"

msgid "settings-config-open"
msgstr "Apri"

#. Piè di pagina.
#. segnaposto: {version}
msgid "settings-version"
msgstr "Scambio {version}"

#. Avviso breve (toast) per ConfigInvalid.
msgid "settings-error-invalid"
msgstr "Valore non accettato"

#. Avviso breve (toast) per RestartRequired (Scambio non avviato da systemd).
msgid "settings-error-restart-required"
msgstr "Salvato: vale dal prossimo avvio di Scambio"

#. Avviso breve (toast); {error} = nome dell’errore D-Bus.
#. segnaposto: {error}
msgid "settings-error-generic"
msgstr "Non riuscito ({error})"

#. Nome del gruppo in Impostazioni di sistema → Scorciatoie (KDE).
msgid "shortcut-component-name"
msgstr "Scambio"

#. Nome dell’azione nelle impostazioni delle scorciatoie del desktop (KDE e portal).
msgid "shortcut-switch-name"
msgstr "Switch intelligente (PC ↔ telefono)"

#. scambio settings senza GTK 4/libadwaita (spec 04).
msgid "cli-error-gtk-missing"
msgstr "La finestra richiede GTK 4 e libadwaita 1.4 o successiva (pacchetti gir1.2-gtk-4.0 e gir1.2-adw-1)"

#. Riga di comando (decisioni 27 e 29b). Stati e codici restano stringhe stabili non tradotte.
msgid "cli-description"
msgstr "Sposta l’audio Bluetooth fra PC e telefono"

msgid "cli-daemon-help"
msgstr "Avvia il demone"

msgid "cli-settings-help"
msgstr "Apri la finestra delle impostazioni"

msgid "cli-debug-help"
msgstr "Registro dettagliato (debug)"

msgid "cli-status-help"
msgstr "Mostra lo stato del demone"

msgid "cli-json-help"
msgstr "Uscita in JSON"

msgid "cli-switch-help"
msgstr "Sposta il dispositivo fra PC e telefono"

msgid "cli-priority-help"
msgstr "Mostra o cambia la Priorità telefono"

msgid "cli-not-running"
msgstr "Scambio non è in esecuzione: avvialo con systemctl --user start scambio"

#. Solo per errori D-Bus non previsti; {error} è il nome tecnico dell’errore.
#. segnaposto: {error}
msgid "cli-dbus-error"
msgstr "Errore D-Bus: {error}"

msgid "cli-error-device-unavailable"
msgstr "Dispositivo non disponibile: Bluetooth spento o fuori portata"

msgid "cli-error-config-invalid"
msgstr "Configurazione non valida: in uso la precedente"

msgid "cli-error-restart-required"
msgstr "Indirizzo del dispositivo cambiato: riavvia con systemctl --user restart scambio"

msgid "cli-help-help"
msgstr "Mostra questo aiuto ed esce"

#. Motivo dell’inibitore di logind (systemd-inhibit --list).
msgid "session-inhibit-reason"
msgstr "Lascia il dispositivo al telefono prima della sospensione"

#. Commenti del modello di config.toml (decisione 84), nella lingua del momento in cui il file viene creato.
msgid "config-header"
msgstr "Configurazione di Scambio. Solo dispositivi già accoppiati. Dopo una modifica: esci da Scambio e riaprilo dal menu"

msgid "config-device-address"
msgstr "Indirizzo Bluetooth del dispositivo (XX:XX:XX:XX:XX:XX)"

msgid "config-device-profile"
msgstr "Profilo del dispositivo: generic oppure meta_glasses"

msgid "config-policy-grab-delay"
msgstr "Millisecondi di audio prima di prendere il dispositivo"

msgid "config-policy-release-idle"
msgstr "Secondi di silenzio prima di lasciarlo al telefono"

msgid "config-policy-connect-timeout"
msgstr "Secondi massimi per collegarlo o scollegarlo"

msgid "config-policy-sink-timeout"
msgstr "Secondi massimi perché compaia la sua uscita audio"

msgid "config-policy-sleep-timeout"
msgstr "Secondi concessi al rilascio prima della sospensione"

msgid "config-policy-unblock"
msgstr "Secondi di silenzio dopo un errore prima di riprovare da solo"

msgid "config-policy-resume-delay"
msgstr "Attesa prima di riprendere la riproduzione dopo la presa; il default dipende dal profilo (generic 0, meta_glasses 2000)"

msgid "config-audio-ignore-roles"
msgstr "Ruoli audio che non fanno passare il dispositivo al PC"

msgid "config-audio-ignore-apps"
msgstr "App (nome o binario) che non fanno passare il dispositivo al PC"

msgid "config-audio-ignore-players"
msgstr "Player MPRIS da non mettere mai in pausa"

msgid "config-shortcut-preferred"
msgstr "Scorciatoia dello switch intelligente"

msgid "config-ui-language"
msgstr "Lingua: auto, it, en oppure de"

msgid "config-ui-tray"
msgstr "Icona nella barra di sistema"

msgid "config-ui-notifications"
msgstr "Notifiche del desktop"

msgid "config-backend-header"
msgstr "Tempi tecnici facoltativi; i default vengono dalle misure"

#. Motivo mostrato dal portal Background (Flatpak, spec 05).
msgid "background-reason"
msgstr "Scambio si avvia all’accesso per passare l’audio fra i tuoi dispositivi"

#. Secondo demone che non ottiene il nome (spec 05).
msgid "daemon-already-running"
msgstr "Scambio è già in esecuzione da un’altra installazione: questa si ferma"

#. scambio --version (spec 05).
msgid "cli-version-help"
msgstr "Mostra la versione ed esce"

