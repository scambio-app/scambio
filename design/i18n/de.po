"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#. Al posto di {device} quando BlueZ non dà un nome. Minuscolo: il codice rende maiuscola la prima lettera della frase.
msgid "tray-device-fallback"
msgstr "das Gerät"

#. Prima riga del menu e del tooltip.
#. segnaposto: {device}
msgid "tray-header-released"
msgstr "{device} — frei für das Handy"

#. segnaposto: {device}
msgid "tray-header-priority"
msgstr "{device} — für das Handy reserviert"

#. segnaposto: {device}
msgid "tray-header-connecting"
msgstr "{device} — wechselt zum PC…"

#. segnaposto: {device}
msgid "tray-header-on-pc"
msgstr "{device} — am PC"

#. segnaposto: {device}
msgid "tray-header-releasing"
msgstr "{device} — zurück zum Handy…"

#. segnaposto: {device}
msgid "tray-header-unavailable"
msgstr "{device} — nicht verfügbar"

msgid "tray-header-not-configured"
msgstr "Kein Gerät eingerichtet"

#. Seconda riga del menu e del tooltip.
msgid "tray-detail-released"
msgstr "Wechselt zum PC, sobald Audio startet"

msgid "tray-detail-priority"
msgstr "Der PC übernimmt es nicht automatisch"

msgid "tray-detail-busy"
msgstr "Einen Moment…"

msgid "tray-detail-playing"
msgstr "PC-Audio läuft"

#. Menu: minuti arrotondati per eccesso, calcolati all’apertura.
#. segnaposto: {minutes}
msgid "tray-detail-idle"
msgstr "In {minutes} Min. zurück zum Handy"

msgid "tray-detail-idle-soon"
msgstr "In weniger als einer Minute zurück zum Handy"

#. Tooltip: ora assoluta HH:MM, così non invecchia.
#. segnaposto: {time}
msgid "tray-detail-idle-at"
msgstr "Um {time} zurück zum Handy"

msgid "tray-detail-on-pc"
msgstr "PC-Audio über das Gerät"

msgid "tray-detail-unavailable"
msgstr "Bluetooth aus oder Gerät außer Reichweite"

#. Spec 05: la finestra sceglie il dispositivo; il percorso del file cambia nel Flatpak.
msgid "tray-detail-not-configured"
msgstr "In den Einstellungen auswählen"

#. Mostrato finché l’errore non è visto (05 §5.4).
msgid "tray-detail-error-connect"
msgstr "Letzter Wechsel fehlgeschlagen: eingeschaltet und in der Nähe?"

msgid "tray-detail-error-sink"
msgstr "Audio verloren: wieder über die PC-Lautsprecher"

msgid "tray-detail-error-release"
msgstr "Rückgabe fehlgeschlagen: bleibt am PC"

msgid "tray-detail-error-config"
msgstr "Ungültige Konfiguration: vorherige wird verwendet"

msgid "tray-action-to-pc"
msgstr "Zum PC holen"

msgid "tray-action-to-phone"
msgstr "Dem Handy überlassen"

msgid "tray-action-priority"
msgstr "Handy-Vorrang"

msgid "tray-action-settings"
msgstr "Einstellungen…"

msgid "tray-action-quit"
msgstr "Scambio beenden"

#. segnaposto: {device}
msgid "notify-grab-failed-title"
msgstr "{device} nicht erreichbar"

msgid "notify-grab-failed-body"
msgstr "Wechsel zum PC fehlgeschlagen. Ist es eingeschaltet und in der Nähe?"

#. segnaposto: {device}
msgid "notify-sink-lost-title"
msgstr "{device}: Audio nicht verfügbar"

msgid "notify-sink-lost-body"
msgstr "Der Ton läuft wieder über die PC-Lautsprecher."

#. segnaposto: {device}
msgid "notify-release-failed-title"
msgstr "{device} bleibt am PC"

msgid "notify-release-failed-body"
msgstr "Rückgabe an das Handy fehlgeschlagen."

#. segnaposto: {device}
msgid "notify-unavailable-title"
msgstr "{device} nicht verfügbar"

msgid "notify-unavailable-body"
msgstr "Bluetooth aus oder Gerät außer Reichweite."

msgid "notify-not-configured-title"
msgstr "Scambio hat kein Gerät"

msgid "notify-not-configured-body"
msgstr "Bluetooth-Adresse in der Konfigurationsdatei eintragen."

msgid "notify-config-invalid-title"
msgstr "Ungültige Konfiguration"

msgid "notify-config-invalid-body"
msgstr "Scambio verwendet weiter die vorherige. Details im Systemprotokoll."

msgid "notify-audio-down-title"
msgstr "Scambio erkennt kein PC-Audio"

msgid "notify-audio-down-body"
msgstr "Ohne sie kein automatischer Wechsel; der manuelle Wechsel funktioniert. pactl prüfen (Paket pulseaudio-utils)."

#. Switch partito fuori dal tray (scorciatoia, CLI).
#. segnaposto: {device}
msgid "notify-switch-to-phone-title"
msgstr "{device} dem Handy überlassen"

msgid "notify-switch-to-phone-body"
msgstr "Handy-Vorrang an: Der PC holt es nicht selbst zurück."

#. segnaposto: {device}
msgid "notify-switch-to-pc-title"
msgstr "{device} am PC"

msgid "notify-switch-to-pc-body"
msgstr "Handy-Vorrang aus."

#. Priorità cambiata fuori dal tray senza switch (es. scambio priority on).
msgid "notify-priority-on-title"
msgstr "Handy-Vorrang an"

#. segnaposto: {device}
msgid "notify-priority-on-body"
msgstr "Der PC übernimmt {device} nicht automatisch."

msgid "notify-priority-off-title"
msgstr "Handy-Vorrang aus"

#. segnaposto: {device}
msgid "notify-priority-off-body"
msgstr "Der PC übernimmt {device}, sobald Audio startet."

msgid "notify-action-retry"
msgstr "Erneut versuchen"

msgid "notify-action-undo"
msgstr "Rückgängig"

msgid "notify-action-open-config"
msgstr "Datei öffnen"

#. Finestra impostazioni (spec 04). Titolo della finestra.
msgid "settings-window-title"
msgstr "Scambio"

#. Banner in cima quando il demone non è sul bus.
msgid "settings-daemon-down"
msgstr "Scambio läuft nicht"

msgid "settings-daemon-start"
msgstr "Starten"

#. Riga di stato quando il demone non è in esecuzione.
msgid "settings-status-unknown"
msgstr "Status nicht verfügbar"

msgid "settings-priority-subtitle"
msgstr "Der PC übernimmt das Gerät nicht automatisch"

msgid "settings-group-device"
msgstr "Gerät"

msgid "settings-device-title"
msgstr "Bluetooth-Brille oder -Kopfhörer"

#. Voce dell’elenco quando non è configurato alcun dispositivo.
msgid "settings-device-none"
msgstr "Keines"

#. Sottotitolo: elenco bloccato mentre il dispositivo è sul PC o in passaggio.
msgid "settings-device-busy"
msgstr "Zum Wechseln zuerst dem Handy überlassen"

msgid "settings-device-empty"
msgstr "Kein gekoppeltes Audiogerät: in den Bluetooth-Einstellungen koppeln"

#. Avviso breve (toast).
msgid "settings-device-restarting"
msgstr "Scambio startet mit dem neuen Gerät neu"

msgid "settings-release-title"
msgstr "Zurück zum Handy nach (Minuten)"

msgid "settings-release-subtitle"
msgstr "Stille am PC. Sofort bei Bildschirmsperre und Standby"

msgid "settings-group-shortcut"
msgstr "Tastenkürzel"

msgid "settings-shortcut-title"
msgstr "Intelligenter Wechsel"

msgid "settings-shortcut-subtitle"
msgstr "Wechselt das Gerät und schaltet den Handy-Vorrang ein oder aus"

#. Al posto del tasto quando la scorciatoia non ha un tasto.
msgid "settings-shortcut-unbound"
msgstr "Keine Taste"

#. Sottotitolo in caso di conflitto. {shortcut} = tasto leggibile (es. Meta+G), {owner} = nome dell’azione che lo usa.
#. segnaposto: {owner}, {shortcut}
msgid "settings-shortcut-conflict"
msgstr "{shortcut} wird bereits von „{owner}“ verwendet"

msgid "settings-shortcut-unsupported"
msgstr "Dieser Desktop bietet keine globalen Tastenkürzel: eine Taste dem Befehl „scambio switch“ zuweisen"

#. Apre Impostazioni di sistema → Scorciatoie (KDE).
msgid "settings-shortcut-change"
msgstr "Ändern…"

msgid "settings-group-general"
msgstr "Allgemein"

msgid "settings-tray"
msgstr "Symbol im Systembereich"

msgid "settings-tray-subtitle"
msgstr "Unter GNOME ist die AppIndicator-Erweiterung nötig"

msgid "settings-notifications"
msgstr "Benachrichtigungen"

msgid "settings-notifications-subtitle"
msgstr "Nur Fehler und von außen geänderter Handy-Vorrang"

msgid "settings-language"
msgstr "Sprache"

#. Le altre voci restano nella propria lingua: Italiano, English, Deutsch.
msgid "settings-language-auto"
msgstr "Automatisch"

#. Avviso breve (toast).
msgid "settings-language-next-open"
msgstr "Das Fenster wechselt beim nächsten Öffnen die Sprache"

msgid "settings-config-title"
msgstr "Konfigurationsdatei"

msgid "settings-config-subtitle"
msgstr "Übernahmeverzögerung, ignorierte Apps und weitere Details"

msgid "settings-config-open"
msgstr "Öffnen"

#. Piè di pagina.
#. segnaposto: {version}
msgid "settings-version"
msgstr "Scambio {version}"

#. Avviso breve (toast) per ConfigInvalid.
msgid "settings-error-invalid"
msgstr "Wert nicht übernommen"

#. Avviso breve (toast) per RestartRequired (Scambio non avviato da systemd).
msgid "settings-error-restart-required"
msgstr "Gespeichert: gilt ab dem nächsten Start von Scambio"

#. Avviso breve (toast); {error} = nome dell’errore D-Bus.
#. segnaposto: {error}
msgid "settings-error-generic"
msgstr "Fehlgeschlagen ({error})"

#. Nome del gruppo in Impostazioni di sistema → Scorciatoie (KDE).
msgid "shortcut-component-name"
msgstr "Scambio"

#. Nome dell’azione nelle impostazioni delle scorciatoie del desktop (KDE e portal).
msgid "shortcut-switch-name"
msgstr "Intelligenter Wechsel (PC ↔ Handy)"

#. scambio settings senza GTK 4/libadwaita (spec 04).
msgid "cli-error-gtk-missing"
msgstr "Das Fenster benötigt GTK 4 und libadwaita 1.4 oder neuer (Pakete gir1.2-gtk-4.0 und gir1.2-adw-1)"

#. Riga di comando (decisioni 27 e 29b). Stati e codici restano stringhe stabili non tradotte.
msgid "cli-description"
msgstr "Bluetooth-Audio zwischen PC und Telefon wechseln"

msgid "cli-daemon-help"
msgstr "Dienst starten"

msgid "cli-settings-help"
msgstr "Einstellungsfenster öffnen"

msgid "cli-debug-help"
msgstr "Ausführliches Protokoll (Debug)"

msgid "cli-status-help"
msgstr "Status des Dienstes anzeigen"

msgid "cli-json-help"
msgstr "Ausgabe als JSON"

msgid "cli-switch-help"
msgstr "Gerät zwischen PC und Handy wechseln"

msgid "cli-priority-help"
msgstr "Handy-Vorrang anzeigen oder ändern"

msgid "cli-not-running"
msgstr "Scambio läuft nicht: mit systemctl --user start scambio starten"

#. Solo per errori D-Bus non previsti; {error} è il nome tecnico dell’errore.
#. segnaposto: {error}
msgid "cli-dbus-error"
msgstr "D-Bus-Fehler: {error}"

msgid "cli-error-device-unavailable"
msgstr "Gerät nicht verfügbar: Bluetooth aus oder außer Reichweite"

msgid "cli-error-config-invalid"
msgstr "Ungültige Konfiguration: vorherige wird verwendet"

msgid "cli-error-restart-required"
msgstr "Geräteadresse geändert: mit systemctl --user restart scambio neu starten"

msgid "cli-help-help"
msgstr "Diese Hilfe anzeigen und beenden"

#. Motivo dell’inibitore di logind (systemd-inhibit --list).
msgid "session-inhibit-reason"
msgstr "Gerät vor dem Standby an das Telefon zurückgeben"

#. Commenti del modello di config.toml (decisione 84), nella lingua del momento in cui il file viene creato.
msgid "config-header"
msgstr "Scambio-Konfiguration. Nur bereits gekoppelte Geräte. Nach einer Änderung: Scambio beenden und über das Menü neu öffnen"

msgid "config-device-address"
msgstr "Bluetooth-Adresse des Geräts (XX:XX:XX:XX:XX:XX)"

msgid "config-device-profile"
msgstr "Geräteprofil: auto (erkennt Meta-Brillen am Namen) oder generic bzw. meta_glasses zur eigenen Wahl"

msgid "config-policy-grab-delay"
msgstr "Millisekunden Audio, bevor das Gerät übernommen wird"

msgid "config-policy-release-idle"
msgstr "Sekunden Stille, bevor es an das Telefon zurückgeht"

msgid "config-policy-connect-timeout"
msgstr "Maximale Sekunden zum Verbinden oder Trennen"

msgid "config-policy-sink-timeout"
msgstr "Maximale Sekunden, bis sein Audioausgang erscheint"

msgid "config-policy-sleep-timeout"
msgstr "Sekunden für die Rückgabe vor dem Standby"

msgid "config-policy-unblock"
msgstr "Sekunden Stille nach einem Fehler, bevor es selbst erneut versucht"

msgid "config-policy-resume-delay"
msgstr "Wartezeit vor dem Fortsetzen der Wiedergabe nach der Übernahme; der Standard hängt vom Profil ab (generic 0, meta_glasses 2000)"

msgid "config-audio-ignore-roles"
msgstr "Audio-Rollen, die das Gerät nicht zum PC holen"

msgid "config-audio-ignore-apps"
msgstr "Apps (Name oder Programmdatei), die das Gerät nicht zum PC holen"

msgid "config-audio-ignore-players"
msgstr "MPRIS-Player, die nie pausiert werden"

msgid "config-shortcut-preferred"
msgstr "Tastenkürzel für den intelligenten Wechsel"

msgid "config-ui-language"
msgstr "Sprache: auto, it, en oder de"

msgid "config-ui-tray"
msgstr "Symbol im Systembereich"

msgid "config-ui-notifications"
msgstr "Desktop-Benachrichtigungen"

msgid "config-backend-header"
msgstr "Optionale technische Zeiten; die Standardwerte stammen aus Messungen"

#. Motivo mostrato dal portal Background (Flatpak, spec 05).
msgid "background-reason"
msgstr "Scambio startet bei der Anmeldung, damit es dein Audio zwischen deinen Geräten weitergeben kann"

#. Secondo demone che non ottiene il nome (spec 05).
msgid "daemon-already-running"
msgstr "Scambio läuft bereits aus einer anderen Installation; diese hier wird beendet"

#. scambio --version (spec 05).
msgid "cli-version-help"
msgstr "Version anzeigen und beenden"

