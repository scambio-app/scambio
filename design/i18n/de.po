msgstr "Wechselt das Gerät und schaltet den iPhone-Vorrang ein oder aus"

msgid "settings-shortcut-change"
msgstr "Ändern…"

msgid "settings-group-general"
msgstr "Allgemein"

msgid "settings-autostart"
msgstr "Bei der Anmeldung starten"

msgid "settings-tray"
msgstr "Symbol im Systembereich"

msgid "settings-language"
msgstr "Sprache"

msgid "settings-language-auto"
msgstr "Automatisch"

msgid "settings-advanced-title"
msgstr "Erweitert"

msgid "settings-advanced-subtitle"
msgstr "Übernahmeverzögerung, Zeitlimits, ignorierte Apps"

msgid "settings-grab-delay-title"
msgstr "Übernahmeverzögerung (Sekunden)"

msgid "settings-grab-delay-subtitle"
msgstr "Wie lange Audio laufen muss, bevor das Gerät übernommen wird"

msgid "settings-ignored-apps-title"
msgstr "Ignorierte Apps"

msgid "settings-ignored-apps-subtitle"
msgstr "Ihr Audio holt das Gerät nicht zum PC"

#. Riga di comando (decisioni 27 e 29b). Stati e codici restano stringhe stabili non tradotte.
msgid "cli-description"
msgstr "Bluetooth-Audio zwischen PC und Telefon wechseln"

msgid "cli-daemon-help"
msgstr "Dienst starten"

msgid "cli-debug-help"
msgstr "Ausführliches Protokoll (Debug)"

msgid "cli-status-help"
msgstr "Status des Dienstes anzeigen"

msgid "cli-json-help"
msgstr "Ausgabe als JSON"

msgid "cli-switch-help"
msgstr "Gerät zwischen PC und iPhone wechseln"

msgid "cli-priority-help"
msgstr "iPhone-Vorrang anzeigen oder ändern"

msgid "cli-not-running"
msgstr "Scambio läuft nicht: mit systemctl --user start scambio starten"

#. Solo per errori D-Bus non previsti; {error} è il nome tecnico dell’errore.
#. segnaposto: {error}
msgid "cli-dbus-error"
msgstr "D-Bus-Fehler: {error}"

msgid "cli-error-device-unavailable"
msgstr "Gerät nicht verfügbar: Bluetooth aus oder außer Reichweite"

msgid "cli-error-config-invalid"
msgstr "Ungültige Konfiguration: vorherige wird verwendet"

msgid "cli-error-restart-required"
msgstr "Geräteadresse geändert: mit systemctl --user restart scambio neu starten"

msgid "cli-help-help"
